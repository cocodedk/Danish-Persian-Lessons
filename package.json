{
  "name": "dpl-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "review:content": "node scripts/export-content-review.mjs",
    "review:audio": "node scripts/export-audio-review.mjs",
    "audio:setup": "bash scripts/audio/setup.sh",
    "audio:queue": "node scripts/export-audio-review.mjs",
    "audio:generate": ".audio/.venv/bin/python scripts/audio/generate.py",
    "audio:review": ".audio/.venv/bin/python scripts/audio/review.py --serve",
    "audio:publish-review": ".audio/.venv/bin/python scripts/audio/publish_review.py",
    "audio:approve": ".audio/.venv/bin/python scripts/audio/approve.py",
    "audio:verify": "python3 scripts/audio/verify.py",
    "audio:verify-review": "python3 scripts/audio/verify_review.py",
    "release:version": "node scripts/release-version.mjs",
    "verify:images": "node scripts/verify-lesson-images.mjs",
    "verify": "npm run lint && npm run test -- --run && npm run build && npm run verify:images && npm run audio:verify && npm run audio:verify-review && bash scripts/verify.sh && npm run e2e:run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
