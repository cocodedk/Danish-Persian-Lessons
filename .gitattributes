# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.js    text
*.ts    text
*.tsx   text
*.css   text
*.html  text
*.json  text
*.yaml  text
*.yml   text
*.md    text
*.sh    text
*.svg   text
*.xml   text
*.toml  text
*.txt   text

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
